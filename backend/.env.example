# ─────────────────────────────────────────────────────────────────────────────
# The Dorm Store — Admin Backend Environment Variables
#
# Copy this file:  cp .env.example .env
# Fill in every value below before starting the server.
#
# ⚠️  NEVER commit .env — it's in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (service_role key gives FULL DB access — backend use only!) ─────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Admin Credentials ──────────────────────────────────────────────────────
# The ONLY admin account. Password must be stored as a bcrypt hash (cost 12).
#
# To generate a hash, run in this directory:
#   node -e "const b=require('bcryptjs'); b.hash('your-password',12).then(h=>console.log(h));"
#
ADMIN_EMAIL=admin@dormstore.com
ADMIN_PASSWORD_HASH=$2a$12$REPLACE_THIS_WITH_YOUR_BCRYPT_HASH

# ── JWT ───────────────────────────────────────────────────────────────────
# Secret for signing admin JWTs. Use a long random string (32+ chars).
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
ADMIN_JWT_SECRET=replace-with-a-very-long-random-secret-string-here
JWT_EXPIRES_IN=2h

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000

# ── CORS ─────────────────────────────────────────────────────────────────
# Only requests from this origin are accepted.
# In development: http://localhost:5173
# In production: your deployed frontend URL
FRONTEND_ORIGIN=http://localhost:5173
