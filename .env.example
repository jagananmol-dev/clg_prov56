# ─────────────────────────────────────────────────────────────
# The Dorm Store — Environment Variables Template
#
# 1. Copy this file:   cp .env.example .env
# 2. Fill in your values from Supabase Dashboard:
#    Project Settings → API → Project URL + anon/public key
#
# ⚠️  NEVER commit .env to git — it is in .gitignore
# ─────────────────────────────────────────────────────────────

# Your Supabase project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anonymous/public key — safe for client-side use
# (Row Level Security policies control what data is actually accessible)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
